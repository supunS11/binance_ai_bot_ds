# design (see market_structure.py). Systematic 107-trade evidence is weak
# and non-monotonic (freshest tercile had the WORST win rate, staleness
# only predicted bigger MAE, not more losses) - see config.py for the
# full reasoning. Default OFF.
HTF_TREND_SWING_AGE_REJECT_ENABLED=False
HTF_TREND_MAX_SWING_AGE_HOURS=72.0
