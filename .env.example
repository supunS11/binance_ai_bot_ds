CVD_DIVERGENCE_DIAGNOSTIC_LOGGING_ENABLED=True
ORDER_BLOCK_RETEST_TRIGGER_ENABLED=True
ORDER_BLOCK_RETEST_MAX_AGE_CANDLES=20
ORDER_BLOCK_RETEST_LOOKBACK_EVENTS=5
OI_DIVERGENCE_TRIGGER_ENABLED=True
OI_DIVERGENCE_MIN_DELTA_PCT=5.0
OI_DIVERGENCE_TRIGGER_MAX_AGE_CANDLES=20
# Same shape/motivation as CVD_DIVERGENCE_DIAGNOSTIC_LOGGING_ENABLED above.
OI_DIVERGENCE_DIAGNOSTIC_LOGGING_ENABLED=True
LIQUIDATION_SWEEP_CONFIRMED_TRIGGER_ENABLED=True
# Temporary, read-only diagnostic (2026-08-25): LIQUIDATION_SWEEP_CONFIRMED
# has never produced a trade. LIQUIDATION_CLUSTER_MIN_NOTIONAL_USDT=50000
