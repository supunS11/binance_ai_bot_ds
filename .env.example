OI_POLL_INTERVAL_SECONDS=60
OI_LOOKBACK_SECONDS=900
OI_HISTORY_MAX_SAMPLES=1440
# Real gate (unlike the OI_* settings above) - reject outright when
# oi_rising is True. Evidence (2026-08-18, 26 resolved trades): oi_rising
# =True at entry saw DCA fire 69% of the time (9/13) vs 17% (2/12) when
# False/unavailable - see config.py's own comment for the full reasoning.
OI_RISING_REJECT_ENABLED=True
LIQUIDATION_CONFIRMATION_ENABLED=True
LIQUIDATION_WINDOW_SECONDS=120
LIQUIDATION_CLUSTER_MIN_NOTIONAL_USDT=50000
LIQUIDATION_MAX_EVENTS_PER_SYMBOL=200
