CORRELATION_LOOKBACK_CANDLES=4
CORRELATION_REFERENCE_SYMBOL=BTCUSDT
# Market-wide flash-crash gate. Real incident (2026-08-22): a BTC flash-
# crash (~2.65% in ~4 min) caught one open BUY position mid-DCA at the
# bottom, realizing a real loss when its SL couldn't even be placed in
# time; every SELL-side position open at the same moment profited from
# the same move. Detection ships on immediately (tracking + transition
# logging only); the two behavior-changing switches ship OFF until it's
# been observed firing correctly against real data a few more times -
# see config.py/crash_detector.py for the full reasoning.
CRASH_DETECTOR_ENABLED=True
