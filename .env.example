# =========================
# TP1 / TP2
# =========================
TP1_CLOSE_PCT=80
# 2026-08-17: was 2.0 - see config.py's comment on this setting. Checked
# against smc's real 270-trade history (same R-multiple, inherited
# unchanged): only 3% of eventual SL_HIT losses ever ran far enough to
# reach 2.0R before reversing, vs 22% reaching at least 1.0R - a real,
# sizeable population currently guaranteed a full loss that a closer
# target converts into a partial win instead.
TP1_R_MULTIPLE=1.0
TP2_R_MULTIPLE=4.0
TP1_MAX_R_MULTIPLE=6.0
TP2_MAX_R_MULTIPLE=10.0
# 2026-08-19: operator-requested alternative to the fully structure-
# resolved TP1 above - TP1 becomes a fixed ROI% target instead, while TP2
# (below TP2_ENABLED) still applies unless separately disabled. See
# config.py's own comment for the full reasoning. No evidence yet either
# way - defaults False; flip to try it live.
TP_STATIC_ROI_ENABLED=False
TP_TARGET_ROI_PCT=40
# 2026-08-28: drops TP2 entirely, closing the whole position at TP1
# instead of the TP1(partial)+TP2(remainder) split - see config.py's own
# comment for the full reasoning (and why TP1_CLOSE_PCT=100 is NOT a safe
# way to do this). Default True (today's TP1+TP2 behavior unchanged).
TP2_ENABLED=True
MOVE_SL_TO_BREAKEVEN_AFTER_TP1=True
# Real gap found live (2026-08-24): a breakeven SL still closed at a net
# loss - every fill in this flow is a taker order, and a round-trip taker
# fee alone (~0.10% at Binance's standard ~0.05%/side rate) already
# exceeded the old 0.02% buffer before any slippage. 0.15% covers that
# plus a real slippage margin - reasoned, not tied to this account's exact
# fee tier. See config.py's own comment for the full reasoning.
BREAKEVEN_BUFFER_PCT=0.15
# Flipped True here (binance_ai_bot_smc keeps it False, live-untested) -
# real historical evidence (2026-08-17, 232-trade journal_analysis.py
# pull): 7% loss rate on trades that reached this trigger vs 69% for
# ones that didn't. See config.py's own comment on this setting.
EARLY_BREAKEVEN_ENABLED=True
EARLY_BREAKEVEN_R_MULTIPLE=0.5
EARLY_BREAKEVEN_LOCK_R_MULTIPLE=0.3
PROFIT_PROTECTION_ENABLED=True
PROFIT_PROTECTION_ACTIVATION_PCT_OF_TP1=80
# 2026-08-18: when TP1's own ROI exceeds this, waiting for 80% of it felt
# unsafe (a large amount of unrealized profit unprotected) - above this
# threshold, PROFIT_PROTECTION_ACTIVATION_PCT_OF_TP1_HIGH_ROI is used
# instead. See config.py's comment on this setting.
PROFIT_PROTECTION_HIGH_TP1_ROI_THRESHOLD_PCT=50
PROFIT_PROTECTION_ACTIVATION_PCT_OF_TP1_HIGH_ROI=50
PROFIT_PROTECTION_LOCK_PCT_OF_TP1=50
PROFIT_PROTECTION_RETRACE_PCT=50
# TP1 under TP_STATIC_ROI_ENABLED is a small, fixed ROI% target, not the
# variable/potentially-large one the activation tiers above assume - real
# trade (TREEUSDT, 2026-08-21): armed at 8% of a 10%-ROI TP1, reversed
# before reaching it, closed for ~4% instead of the full 10%. Skips
# profit protection for the pre-TP1 leg only when static ROI is on; the
# post-TP1 remainder toward the real (structure-based) TP2 is untouched.
# See config.py's own comment for the full reasoning.
PROFIT_PROTECTION_SKIP_FOR_STATIC_TP1_ENABLED=True
# Real gap found live (2026-08-23): once a genuine TP1 fill promotes the
# remainder to BREAKEVEN_ACTIVE, profit protection never had a fresh-arm
# path for that leg - only a position that already armed pre-TP1 keeps
# trailing it. TP2 is always real/structure-based (never a small fixed
# target the way TP1 can be), so it fits this mechanism's own premise.
# Reuses the same PROFIT_PROTECTION_ACTIVATION_PCT_OF_TP1/LOCK_PCT_OF_TP1/
# RETRACE_PCT knobs above, applied against tp2_price instead. Requires
# PROFIT_PROTECTION_ENABLED also on. New, zero live track record yet -
# see config.py's own comment for the full reasoning.
PROFIT_PROTECTION_TP2_LEG_ENABLED=False
STRUCTURE_STOP_MANAGEMENT_ENABLED=True
MAE_TRACKING_ENABLED=True

# =========================
# DCA (single average-in, no SL before it fires) - see config.py's DCA
# section for the full mechanism and the real risk being accepted.
# =========================
DCA_ENABLED=True
DCA_SIZE_MULTIPLIER=1.0
# 2026-08-17: was 4.0/10.0 (a straight copy of TP2's own numbers) - see
# config.py's comment on this setting for why that put the post-DCA target
# ~3.8x further than TP2 itself, measured against 3 real DCA fires.
DCA_TP_R_MULTIPLE=1.0
DCA_TP_MAX_R_MULTIPLE=2.5
# 2026-08-19: operator-requested alternative to the structure/R-multiple
# target above - a fixed ROI% target computed straight from the blended
# post-DCA entry price, independent of structure/pools entirely. No
# evidence yet either way - defaults False; flip to try it live.
DCA_TP_STATIC_ROI_ENABLED=False
DCA_TP_TARGET_ROI_PCT=50
DCA_STRUCTURE_STOP_ATR_BUFFER=0.5
# 2026-08-20: operator-requested (real trade - LITUSDT, 2026-08-19: DCA
# fired straight into a move that never showed any sign of turning, hit
# its post-DCA SL ~2 minutes later). Does NOT delay when DCA fires - this
# project's no-SL-before-DCA design means delaying would leave the
# position naked for LONGER, not safer. Instead checks order flow (the
# same signal_engine.direction_still_confirmed primitive DCA_BREAKEVEN_
# CONFIRMATION_ENABLED already reuses) at the instant DCA fires and, only
# when NOT confirmed, commits DCA_PRESSURE_SIZE_MULTIPLIER instead of
# DCA_SIZE_MULTIPLIER at a DCA_PRESSURE_TIGHT_STOP_ATR_BUFFER stop instead
# of DCA_STRUCTURE_STOP_ATR_BUFFER - see config.py for the full reasoning.
# Can only make a fire more conservative than today, never less. No
# DCA_TP_HIT/DCA_SL_HIT evidence yet either way - defaults False.
DCA_PRESSURE_CHECK_ENABLED=False
DCA_PRESSURE_SIZE_MULTIPLIER=0.5
DCA_PRESSURE_TIGHT_STOP_ATR_BUFFER=0.25
# Places the DCA add itself as a real resting LIMIT order at dca_price
# (instead of a candle-range poll + reactive market order) so a gap or
# violent move gets a real exchange-side circuit breaker, not just the
# next poll tick - see config.py for the full reasoning, including the
# real 2026-08-22 incident this closes and why it always rests at the
# conservative DCA_PRESSURE_SIZE_MULTIPLIER size, never full size. New,
# unvalidated mechanism touching real order placement - defaults False.
DCA_RESTING_ORDER_ENABLED=False
# Closes the gap where a DCA_ACTIVE trade that recovers to breakeven and
# then reverses had nothing protecting it (PROFIT_PROTECTION needs a much
# deeper move, STRUCTURE_STOP needs a new confirmed swing) - see config.py.
DCA_BREAKEVEN_ENABLED=True
# 2026-08-19: two-phase rollout, zero trades have used this yet - see
# config.py's own comments for the full reasoning. ENABLED alone only
# computes+journals whether the trend/order-flow picture still confirms
# the position when it reaches breakeven (signal_journal.py's
# dca_breakeven_direction_confirmed); the real breakeven move still
# happens unconditionally either way. WITHHOLD is the actual behavior
# change - only lets a confirmed verdict skip that move - and stays False
# until there's real evidence behind it.
DCA_BREAKEVEN_CONFIRMATION_ENABLED=False
DCA_BREAKEVEN_CONFIRMATION_WITHHOLD_ENABLED=False
# 2026-08-26: MEUSDT incident (SELL, DCA'd, recovered to breakeven, then
# reversed before the poll-based cancel+replace round trip landed -
# Binance rejected the new SL with -2021 and the existing fallback closed
# at market instead). Places a real, dormant TRAILING_STOP_MARKET the
# moment DCA fires, activatePrice=breakeven - Binance arms and trails it
# server-side the instant price reaches breakeven, no bot polling, no
# cancel/replace race. Real, UNVERIFIED assumption: this requires a
# closePosition=true STOP_MARKET and a closePosition=true
# TRAILING_STOP_MARKET to coexist simultaneously - this codebase has only
# ever proven DIFFERENT-type closePosition orders coexist (SL+TP) and
# rejects SAME-type duplicates (-4130, a real 2026-08-08 incident). Ships
# gated + best-effort/non-fatal: a rejection just means the position
# keeps its existing wide SL exactly as today. Stays False until
# deliberately enabled - the first live DCA-breakeven event under the
# flag is the real-world confirmation of the coexistence assumption.
DCA_BREAKEVEN_TRAILING_STOP_ENABLED=False
# Binance's real minimum is 0.1 (python-binance's futures_create_algo_
# order docstring); 0.2 is a small safety margin above the floor, not
# outcome-validated - same "starting value, revisit once real data
# exists" convention as RETRACEMENT_ENTRY_OFFSET_R etc. Deliberately
# capped at 5 in code (_normalize_callback_rate), well below Binance's
# documented max of 10 - a callback that wide would give back far more
# profit than the flat breakeven stop it's replacing was ever designed
# to risk.
DCA_BREAKEVEN_TRAILING_CALLBACK_RATE=0.2

# =========================
# EXECUTION
# =========================
# SHADOW here (binance_ai_bot_smc's equivalent live bot runs LIVE) - the
# no-SL-before-DCA mechanism has zero real track record yet. Flip to LIVE
# only once shadow results have actually been reviewed.
EXECUTION_MODE=SHADOW
# Comma-separated signal_trigger names forced into shadow regardless of
# EXECUTION_MODE above - empty by default (no per-trigger override).
SHADOW_ONLY_TRIGGERS=
POSITION_POLL_INTERVAL_SECONDS=10
SIGNAL_EVAL_INTERVAL_SECONDS=3
SIGNAL_CONFIRM_TICKS=3
SHADOW_ACCOUNT_BALANCE_USDT=1000
# config.DCA_ENABLED takes priority over this routing entirely (see
# main.py's own comment above use_limit) - left True here only so the
# routing decision is exercised/visible if DCA_ENABLED is ever turned
# off for a comparison run.
LIMIT_ENTRY_MODE_ENABLED=True
ENTRY_ROUTING_EXTENSION_THRESHOLD_R=0.2
LIMIT_ENTRY_EXPIRY_SECONDS=600
# 2026-08-20: real evidence (24 resolved trades cross-checked against
# real 1-minute price data) - 75% of entries dip at least 0.1R against
# the position within 5 minutes, regardless of trigger type, before many
# of them go on to win anyway. Takes priority over DCA_ENABLED/
# LIMIT_ENTRY_MODE_ENABLED's own routing when on; ALWAYS falls back to a
# market order for whatever doesn't fill by the timeout, so it never
# skips a signal - see config.py's own comment for the full mechanism.
# No live track record of the mechanism itself yet - defaults False.
RETRACEMENT_ENTRY_ENABLED=False
RETRACEMENT_ENTRY_OFFSET_R=0.1
RETRACEMENT_ENTRY_TIMEOUT_SECONDS=300
# RETRACEMENT_ENTRY_OFFSET_R above is a pure calculation, not tied to
# real market structure. Investigated (2026-08-22, 21 real signals): a
# real level (FVG edge, liquidity pool) sat between entry and SL for
# 14/21 (67%), but its own distance varied 0.024R-0.717R - not clustered
# near 0.125. When on, prefers the nearest real level within
# RETRACEMENT_STRUCTURE_MAX_R over the fixed-R calc; falls back
# otherwise. Exploratory - default OFF, see config.py's own comment.
RETRACEMENT_STRUCTURE_TARGET_ENABLED=False
RETRACEMENT_STRUCTURE_MAX_R=0.35

# =========================
# LOGGING / ALERTING
# =========================
# Off by default - a separate, unproven project alerting into the same
# chat as the live binance_ai_bot_smc bot would mix real and shadow-mode
# signals in one place. Fill in and flip True once you want it.
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_PREFIX=Binance Bot DS
TELEGRAM_TIMEOUT_SECONDS=10
