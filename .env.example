LONG_SHORT_RATIO_ENABLED=True
EFFICIENCY_RATIO_CHOP_THRESHOLD=0.3
EFFICIENCY_RATIO_GATE_ENABLED=True
# Real evidence (2026-08-25): recalibrated from 0.0005 to the actual p90 of
# the signed funding_rate distribution across 118 resolved trades
# (p50=0.000043, p90=0.000100, p95=0.000245) - the old value only ever
# flagged 3/118 trades "unfavorable" (unmeasurable); this flags ~11/118.
# Informational-only field, never gates a trade - see config.py's comment.
FUNDING_RATE_ADVERSE_THRESHOLD=0.0001
LONG_SHORT_RATIO_CROWD_THRESHOLD=2.0
REQUIRE_CLOSE_CONFIRMED_BREAK=True
LIQUIDITY_SWEEP_TRIGGER_ENABLED=True
CHOCH_RETEST_TRIGGER_ENABLED=True
CHOCH_TRIGGER_MAX_AGE_CANDLES=10
# 2026-08-21: real evidence - 13 resolved CHOCH_RETEST trades with real
# setup_age_candles data, age==10 (the max) went 4/4 wins, every younger
# age (4-8) combined went 2/9. CHOCH_RETEST was also the single worst
# trigger project-wide (47% win rate, 53% of all DCA events on 30% of
# volume). Reject-only - see config.py's own comment for the full
# reasoning and why 9, not the literal max of 10.
CHOCH_TRIGGER_MIN_AGE_CANDLES=9
# Real evidence (2026-08-24, 32 resolved CHOCH_RETEST trades): depth_
# imbalance clearly favorable (signed >=0.10 toward the trade's own side)
# won 75.0% (n=12) vs only 55.0% (n=20) when merely neutral. Tested the
# trend-agreement hypothesis first (does CHOCH_RETEST need AGAINST_HTF_
# BIAS/HTF_TREND_STALE after all) and found it flat (62.5% either way) -
# depth was the one real lead. Reject-only. See config.py's own comment
# for the full reasoning.
CHOCH_RETEST_MIN_DEPTH_IMBALANCE=0.10
# Real evidence (2026-08-25 signal-engine audit, 33 resolved OB_FVG_RETEST
# trades): depth_imbalance clearly favorable (signed >=0.10) won 90.0%
# (n=10) vs 73.9% (n=23) when merely neutral - same shape as the
# CHOCH_RETEST fix above. Reject-only. See config.py's own comment for
# the full reasoning, including why EMA_PULLBACK must NOT reuse this.
OB_FVG_RETEST_MIN_DEPTH_IMBALANCE=0.10
OB_FVG_RETEST_TRIGGER_ENABLED=True
OB_FVG_RETEST_MAX_AGE_CANDLES=20
# How far the retest candle's close has to reclaim back out of the gap
# before it qualifies (0.0=old behavior, close anywhere past the far
# edge; 1.0=full close back outside the gap). Real motivation
# (2026-08-22): live OB_FVG_RETEST trades averaged ~0.68R max adverse
# excursion even on eventual wins (28% of wins still ran 1R+ against the
# position first) - see config.py/market_structure.py for the full
# reasoning. Reasoned default, not yet outcome-validated - revisit once
# trades post-dating this change have resolved.
OB_FVG_RETEST_MIN_CLOSE_THROUGH_PCT=0.5
EXTRA_CONFIRM_TICKS_FOR_NEW_TRIGGERS=1
STRUCTURE_BREAK_EXTRA_CONFIRM_TICKS=0
TRIGGER_QUALITY_RANKING_ENABLED=True
TRIGGER_QUALITY_EDGE_ATR_MULTIPLE=0.25

